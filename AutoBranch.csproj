<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoBranch</AssemblyName>
    <RootNamespace>AutoBranchMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Gorilla Tag install folder. Override with: dotnet build -p:GameDir="D:\path\to\Gorilla Tag" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Gorilla Tag</GameDir>
    <ManagedDir>$(GameDir)\Gorilla Tag_Data\Managed\</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core\</BepInExCoreDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>

  <!-- Same publicizer Poison uses, so non-public game members compile -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true" Private="false">
      <HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="$(ManagedDir)*.dll"
               Exclude="$(ManagedDir)Assembly-CSharp.dll;$(ManagedDir)mscorlib.dll;$(ManagedDir)netstandard.dll;$(ManagedDir)System*.dll;$(ManagedDir)Microsoft*.dll;$(ManagedDir)Mono*.dll;$(ManagedDir)Unity.Burst*.dll;$(ManagedDir)Unity.Collections*.dll"
               Private="false" />
    <Reference Include="BepInEx" Private="false">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

  <!-- Copy the built dll into BepInEx\plugins after a successful build -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(PluginsDir)" />
  </Target>

</Project>
